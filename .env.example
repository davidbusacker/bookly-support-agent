# Required — Claude powers all agent intelligence (tool-use loop + responses)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
# Fast model for intent / resolution / restock matching (Riley replies still use ANTHROPIC_MODEL)
CLASSIFIER_MODEL=claude-haiku-4-5

# Required for spoken agent replies (TTS). STT uses browser Web Speech API.
ELEVENLABS_API_KEY=sk-your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2

# Bookly OMS — MCP server (primary); REST manifest is automatic fallback
BOOKLY_MCP_URL=https://bookly.davidbusacker.com/mcp
BOOKLY_TRANSPORT=mcp
BOOKLY_API_BASE_URL=https://bookly.davidbusacker.com
BOOKLY_MANIFEST_URL=https://bookly.davidbusacker.com/api/public/tools.json

# Intent / resolution cutoffs — enforced only in agent/pipeline.py, not in classifier prompts.
INTENT_CONFIDENCE_THRESHOLD=0.50

# After a turn is this resolved, ask confirm then maybe restock (enforced in pipeline.py).
RESOLUTION_THRESHOLD=0.90
